# Turso database
# Create a database at https://turso.tech and copy its connection details.
TURSO_CONNECTION_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Better Auth
# Use the production Vercel URL after the first deployment.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace_with_a_random_32_character_secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace every placeholder with the values from Turso and your deployment
# 3. Add the same variables in Vercel under Project Settings > Environment Variables
# 4. Never commit .env.local to version control
